```gitignore
# ============================================================
# DEPENDENCIAS
# ============================================================

node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml


# ============================================================
# ARCHIVOS DE ENTORNO (.env) - ¡NUNCA SUBIR!
# ============================================================

.env
.env.local
.env.*.local
.env.production
.env.development

backend/.env
frontend/.env


# ============================================================
# LOGS
# ============================================================

*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

combined.log
error.log
logs/

backend/combined.log
backend/error.log


# ============================================================
# ARCHIVOS CORRUPTOS O DE RESPALDO
# ============================================================

*.corrupt.*
*.backup
*.bak
*.tmp
*.temp*
*.swp
*.swo
*~

backend/data/*.corrupt.*
backend/data/*.backup
backend/data/*.bak


# ============================================================
# ARCHIVOS DEL SISTEMA
# ============================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

*.exe
*.dll


# ============================================================
# SUBIDAS DE USUARIOS
# ============================================================
# IMPORTANTE:
# NO ignoramos jpg/png/webp globalmente.
# Las imágenes de frontend/images/ SÍ se subirán a GitHub.
#
# Solamente se ignoran archivos que los usuarios suban.

frontend/uploads/
backend/uploads/
uploads/

frontend/uploads/*
backend/uploads/*
uploads/*

!frontend/uploads/.gitkeep
!backend/uploads/.gitkeep
!uploads/.gitkeep


# ============================================================
# BASE DE DATOS
# ============================================================

*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-shm
*.sqlite-wal

backend/data/*.db
backend/data/*.db.*
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/*.sqlite3.*
backend/data/*.db-journal


# ============================================================
# CACHÉ Y ARCHIVOS TEMPORALES
# ============================================================

.cache/
.cache-loader/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist/

dist/
build/

.nyc_output/
coverage/

*.cache


# ============================================================
# IDE Y EDITORES
# ============================================================

.vscode/
.idea/
.vs/

*.iml
.project
.classpath
.settings/

*.swp
*.swo
*~
.*~

*.code-workspace


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.pyc
*.pyo

venv/
env/
.venv/

.pytest_cache/
.python-version

*.egg-info/
*.egg*

backend/__pycache__/
backend/*.pyc


# ============================================================
# MODELOS DE IA - ARCHIVOS GRANDES
# ============================================================
# Los modelos se descargan automáticamente.
# NO subirlos a GitHub.

backend/models/

models/

*.onnx
*.bin
*.pt
*.pth
*.model


# ============================================================
# ARCHIVOS DE PROYECTO ESPECÍFICOS
# ============================================================

backend/data/reports/

backend/data/*.db*
backend/data/*.sqlite
backend/data/*.sqlite3*
backend/data/*.db-journal
backend/data/*.backup*
backend/data/*.corrupt.*


# ============================================================
# ARCHIVOS DE COMPILACIÓN
# ============================================================

*.class
*.jar
*.war
*.ear


# ============================================================
# CERTIFICADOS Y CLAVES PRIVADAS
# ============================================================

*.pem
*.key
*.crt
*.csr
*.p12
*.pfx


# ============================================================
# OTROS ARCHIVOS TEMPORALES
# ============================================================

*.lock
*.pid

*.orig
*.rej
*.old
*.new
*.save
*.sav
*.original


# ============================================================
# CARPETAS DE FRONTEND QUE NO SE UTILIZAN
# ============================================================

frontend/admin/
frontend/feed/
frontend/pay/
frontend/profile/
frontend/js/


# ============================================================
# ARCHIVOS DE FRONTEND QUE NO SE UTILIZAN
# ============================================================

frontend/a.html
frontend/admin.html
frontend/chat.html
frontend/emoji.html
frontend/feed.html
frontend/index.html
frontend/profile.html
frontend/settings.html
frontend/test-translate.html
frontend/vyin.pay.html

frontend/app.js
frontend/profile.js
frontend/splash.js
frontend/splash.css
```
